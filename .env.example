# ── AI (OpenRouter) ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
# Initial model — overridable at runtime via the Admin panel (stored in data/admin.json)
OPENROUTER_MODEL=qwen/qwen3-235b-a22b

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Server ────────────────────────────────────────────────────────────────────
SESSION_SECRET=change_me_to_a_long_random_string
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# ── Access control ────────────────────────────────────────────────────────────
# Initial allowed-email list — overridable at runtime via the Admin panel (stored in data/admin.json).
# Comma-separated. Leave empty to allow all Google accounts (open access).
ALLOWED_EMAILS=

# Comma-separated list of admin emails. Admins can access the Admin panel to
# toggle the app on/off, manage allowed users, and change the AI model.
# Only changeable here (in .env) — never exposed via the API.
ADMIN_EMAILS=your_admin_email@example.com
